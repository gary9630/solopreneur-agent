# Copy to .env for local live integrations. Keep real values out of git.

# NVIDIA NIM Serverless Inference
NVIDIA_API_KEY=replace-with-nvidia-api-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=replace-with-nim-model

# Odoo local demo and API access
ODOO_URL=http://localhost:8069
ODOO_DATABASE=odoo
ODOO_USERNAME=admin
ODOO_API_KEY=replace-with-odoo-api-key
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=replace-with-local-db-password

# Linear API
LINEAR_API_KEY=replace-with-linear-api-key
LINEAR_TEAM_ID=replace-with-linear-team-id

# GitHub API
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPOSITORY=owner/repository

# Telegram Bot API
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# NemoClaw sandbox name used by helper scripts
SANDBOX=deal-demo
