{
  "id": "solopreneur-tools",
  "name": "Solopreneur Tools",
  "description": "Composable Odoo, delivery, and stakeholder tools for the solopreneur agent demo.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gatewayBaseUrl": {
        "type": "string",
        "description": "Base URL for the host-side agent_app tool gateway.",
        "default": "http://host.openshell.internal:8088"
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "crm_lookup",
      "business_card_capture",
      "deal_prepare",
      "odoo_upsert_contact",
      "odoo_create_crm_lead",
      "odoo_create_sale_order",
      "odoo_create_draft_invoice",
      "odoo_create_deal_artifacts",
      "delivery_create_tasks",
      "notify_stakeholder"
    ]
  }
}
