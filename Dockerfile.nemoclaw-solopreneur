ARG SANDBOX_BASE=ghcr.io/nvidia/nemoclaw/sandbox-base:latest
FROM ${SANDBOX_BASE}

COPY openclaw_plugins/solopreneur-tools/ /opt/solopreneur-tools/

RUN mkdir -p /sandbox/.openclaw/extensions \
 && cp -a /opt/solopreneur-tools /sandbox/.openclaw/extensions/solopreneur-tools \
 && openclaw plugins validate --root /sandbox/.openclaw/extensions/solopreneur-tools --entry dist/index.js \
 && chown -R sandbox:sandbox /sandbox/.openclaw/extensions/solopreneur-tools \
 && openclaw doctor --fix

WORKDIR /opt/nemoclaw
