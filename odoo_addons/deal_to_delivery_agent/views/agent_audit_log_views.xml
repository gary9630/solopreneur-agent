<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_deal_agent_audit_log_list" model="ir.ui.view">
        <field name="name">deal.agent.audit.log.list</field>
        <field name="model">deal.agent.audit.log</field>
        <field name="arch" type="xml">
            <list string="Agent Audit Logs" create="false" edit="false">
                <field name="created_at"/>
                <field name="run_id"/>
                <field name="step_name"/>
                <field name="service"/>
                <field name="state_before"/>
                <field name="state_after"/>
                <field name="external_ref"/>
            </list>
        </field>
    </record>

    <record id="view_deal_agent_audit_log_form" model="ir.ui.view">
        <field name="name">deal.agent.audit.log.form</field>
        <field name="model">deal.agent.audit.log</field>
        <field name="arch" type="xml">
            <form string="Agent Audit Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="run_id"/>
                            <field name="step_name"/>
                            <field name="service"/>
                        </group>
                        <group>
                            <field name="created_at"/>
                            <field name="state_before"/>
                            <field name="state_after"/>
                            <field name="external_ref"/>
                        </group>
                    </group>
                    <group>
                        <field name="deal_context_id"/>
                        <field name="payload_summary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deal_agent_audit_logs" model="ir.actions.act_window">
        <field name="name">Agent Audit Logs</field>
        <field name="res_model">deal.agent.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
